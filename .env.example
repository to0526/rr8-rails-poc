# このファイルをコピーして .env を作成する: cp .env.example .env
# .env はgit管理対象外(.gitignore参照)。環境ごとに値を変えたい場合はここではなく .env を編集する。

# Rails側のCORS許可オリジン(フロントエンドの開発サーバーURL)
# backend/config/initializers/cors.rb でrack-corsがこの値を読み込み、許可オリジンとして設定する
FRONTEND_ORIGIN=http://localhost:5173

# フロントエンドから見たRails APIのベースURL(ブラウザから直接アクセスするため localhost 指定)
# frontend/app/lib/api.ts でこの値を読み込み、fetch のベースURLとして使う
VITE_API_BASE_URL=http://localhost:3000/api/v1

# サーバー側(loader/action がNodeプロセス内で実行される場合)から見たRails APIのベースURL。
# frontendコンテナ内のNodeプロセスから見ると localhost は自分自身を指してしまうため、
# docker-composeのサービス名 "backend" で疎通する
# 注意: VITE_ prefixを付けないこと。付けるとViteによってクライアント(ブラウザ)向けの
# JSバンドルにも埋め込まれてしまい、ブラウザから到達できない "backend" というホスト名が
# 漏れてしまう(frontend/app/lib/api.ts 参照)
API_BASE_URL_INTERNAL=http://backend:3000/api/v1

# ホストからMySQLへ接続する際のポート番号(任意)
# ホスト側で3306番が既に使われている場合(ローカルにMySQLが入っている等)にコメントを外して変更する
# コンテナ同士(backend<->db)の通信には影響しない
# DB_PORT=3307
